default_platform(:ios)

platform :ios do

  desc "Sync code-signing certificates via match"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: true,
      verbose: true,
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_JSON_PATH"]
    )
  end

  desc "Generate certificates (first-time setup only)"
  lane :generate_certificates do
    match(
      type: "appstore",
      readonly: false,
      force_for_new_devices: true,
      verbose: true,
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_JSON_PATH"]
    )
  end

  desc "Build and upload to TestFlight"
  lane :deploy_testflight do
    sync_certificates

    build_number = Time.now.strftime("%Y%m%d%H%M%S")
    increment_build_number(
      build_number: build_number,
      xcodeproj: "PocDedicatedScanner.xcodeproj"
    )

    build_app(
      workspace: "PocDedicatedScanner.xcworkspace",
      scheme: "PocDedicatedScanner",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"iPhone Distribution\" DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} PROVISIONING_PROFILE_SPECIFIER=\"match AppStore com.poc.dedicatedscanner\"",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          "com.poc.dedicatedscanner" => "match AppStore com.poc.dedicatedscanner"
        }
      }
    )

    pilot(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_JSON_PATH"],
      skip_waiting_for_build_processing: true
    )
  end

end
